{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "credentialsSource": "remote",
      "developmentClient": true,
      "distribution": "internal",
      "extends": "production"
    },
    "preview": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "extends": "production"
    },
    "production": {
      "credentialsSource": "remote",
      "autoIncrement": false,
      "android": {
        "gradleCommand": ":assembleFullRelease"
      },
      "bun": "1.4.4",
      "node": "24.22.3"
    }
  },
  "submit": {
    "production": {}
  }
}
