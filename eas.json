{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "credentialsSource": "remote",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleFullDebug"
      },
      "bun": "1.4.4"
    },
    "preview": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleFullDebug"
      },
      "bun": "1.4.4"
    },
    "production": {
      "credentialsSource": "remote",
      "autoIncrement": true,
      "android": {
         "gradleCommand": ":assembleFullRelease"
      },
      "bun": "1.4.4"
    }
  },
  "submit": {
    "production": {}
  }
}
